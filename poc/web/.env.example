# ─── BFF : variables SERVEUR (jamais exposées au navigateur, PAS de préfixe NEXT_PUBLIC_) ───
# Le navigateur n'appelle que /api/proxy ; le proxy relaie vers le kernel en injectant
# l'identité de l'application cliente. À définir aussi dans les env vars Vercel.
KSM_BACKEND_URL=https://kernel-core.yowyob.com
KSM_CLIENT_ID=your-client-id
KSM_CLIENT_KEY=your-client-secret
KSM_TENANT_ID=00000000-0000-0000-0000-000000000001

# ─── Public : non secrets ───
NEXT_PUBLIC_CLIENT_ID=your-client-id
NEXT_PUBLIC_TENANT_ID=00000000-0000-0000-0000-000000000001
NEXT_PUBLIC_SERVICE_CODE=SALES
# Laisser vide : le front tape /api/proxy sur sa propre origine (ne définir que si le BFF est sur un autre hôte).
NEXT_PUBLIC_API_BASE_URL=
